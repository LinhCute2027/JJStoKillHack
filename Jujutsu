local function make_card(name, title, w, h)
    local f = create("Frame", {
        Name = name, Size = UDim2.fromOffset(w,h),
        Position = UDim2.new(0.5,-w/2,0.5,-h/2),
        BackgroundColor3 = theme.bg, ClipsDescendants = true, ZIndex = 60, Parent = gui,
    })
    corner(f, 8); add_stroke(f, theme.stroke)
    local head = create("Frame", { Size = UDim2.new(1,0,0,32), BackgroundColor3 = theme.panel, Parent = f })
    create("Frame", { Size = UDim2.new(1,0,0,1), Position = UDim2.new(0,0,1,-1), BackgroundColor3 = theme.stroke_soft, Parent = head })
    create("TextLabel", {
        Position = UDim2.fromOffset(14,0), Size = UDim2.new(1,-40,1,0), BackgroundTransparency = 1,
        Text = title, Font = font_med, TextSize = 12, TextColor3 = theme.text,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = head,
    })
    local xb = create("TextButton", {
        Size = UDim2.fromOffset(32,32), Position = UDim2.new(1,-32,0,0), BackgroundTransparency = 1,
        Text = "x", Font = font_ui, TextSize = 12, TextColor3 = theme.text_dim, AutoButtonColor = false, Parent = head,
    })
    xb.MouseEnter:Connect(function() xb.TextColor3 = theme.accent end)
    xb.MouseLeave:Connect(function() xb.TextColor3 = theme.text_dim end)
    xb.MouseButton1Click:Connect(function() f.Visible = false end)
    make_draggable(f, head)
    return f
end


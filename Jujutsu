-- VirtualInputManager — fallback bắt buộc
--=============================================================
local VIM
pcall(function() VIM = game:GetService("VirtualInputManager") end)

local function _mouse_pos()
    local m = UserInputService:GetMouseLocation()
    return math.floor(m.X), math.floor(m.Y)
end

local function _vim_mouse(button, is_down, hold)
    if not VIM then return false end
    local x, y = _mouse_pos()
    -- button: 0 = left, 1 = right, 2 = middle (theo spec VIM)
    local ok = pcall(function()
        VIM:SendMouseButtonEvent(x, y, button, is_down, game, button + 1)
    end)
    if ok and hold and hold > 0 and is_down then
        task.wait(hold)
        pcall(function() VIM:SendMouseButtonEvent(x, y, button, false, game, button + 1) end)
    end
    return ok
end

local function _vim_key(keycode, is_down, hold)
    if not VIM then return false end
    local ok = pcall(function()
        VIM:SendKeyEvent(is_down, keycode, false, game)
    end)
    if ok and hold and hold > 0 and is_down then
        task.wait(hold)
        pcall(function() VIM:SendKeyEvent(false, keycode, false, game) end)
    end
    return ok
end


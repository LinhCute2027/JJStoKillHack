local nav_items = {}
local current_page = nil

local function set_page(id)
    current_page = id
    for key, item in pairs(nav_items) do
        local active = key == id
        item.label.TextColor3 = active and theme.text or theme.text_dim
        item.label.Font = active and font_med or font_ui
        item.bar.Visible = active
        item.row.BackgroundTransparency = 1
    end
    for key, page in pairs(pages) do
        page.Visible = key == id
    end
    if pages[id] then
        pages[id].CanvasPosition = Vector2.new(0, 0)
    end
end


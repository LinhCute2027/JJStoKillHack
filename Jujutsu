            Anchored = false, CanCollide = false,
            Parent = model,
        })
    end

    local skin = Color3.fromRGB(245, 205, 60)
    local hrp = mk("HumanoidRootPart", Vector3.new(2, 2, 1), skin, Vector3.new(0, 3, 0))
    hrp.Transparency = 1
    local torso = mk("Torso", Vector3.new(2, 2, 1), Color3.fromRGB(0, 92, 175), Vector3.new(0, 3, 0))
    local head = mk("Head", Vector3.new(2, 1, 1), skin, Vector3.new(0, 4.5, 0))

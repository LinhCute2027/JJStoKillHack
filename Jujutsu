    create("Decal", { Face = Enum.NormalId.Front, Texture = "rbxasset://textures/face.png", Parent = head })
    local la = mk("Left Arm", Vector3.new(1, 2, 1), skin, Vector3.new(-1.5, 3, 0))
    local ra = mk("Right Arm", Vector3.new(1, 2, 1), skin, Vector3.new(1.5, 3, 0))

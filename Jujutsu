function preview_animation(id)
    if not preview.animator then return end
    local digits = tostring(id):match("%d+")
    if not digits then return end
    preview.last_id = digits
    local anim = Instance.new("Animation"); anim.AnimationId = "rbxassetid://" .. digits
    local ok, track = pcall(function() return preview.animator:LoadAnimation(anim) end)
    if not ok or not track then return end
    if preview.track then pcall(function() preview.track:Stop() end) end
    track.Priority = Enum.AnimationPriority.Action
    track.Looped = true; track:Play(); track:AdjustSpeed(preview.speed)
    preview.track = track
end

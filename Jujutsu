local function make_color_row(parent, label, initial_color, on_change)
    local row = create("Frame", {
        Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1,
        LayoutOrder = next_order(), Parent = parent,
    })
    create("TextLabel", {
        Size = UDim2.new(0, 110, 1, 0), BackgroundTransparency = 1, Text = label,
        Font = font_med, TextSize = 11, TextColor3 = theme.text,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
    })
    local swatch_wrap = create("Frame", {
        Size = UDim2.new(0, 180, 0, 16), Position = UDim2.new(0, 110, 0.5, -8),
        BackgroundTransparency = 1, Parent = row,
    })
    create("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = swatch_wrap,
    })
    local current_color = initial_color
    local preview_btn
    for i, col in ipairs(palette) do
        local sw = create("TextButton", {
            Size = UDim2.fromOffset(14, 14), BackgroundColor3 = col,
            Text = "", AutoButtonColor = false, LayoutOrder = i, Parent = swatch_wrap,
        })
        corner(sw, 7); add_stroke(sw, theme.stroke, 1)
        sw.MouseButton1Click:Connect(function()
            current_color = col
            if preview_btn then preview_btn.BackgroundColor3 = col end
            if on_change then on_change(col) end
        end)
    end
    preview_btn = create("TextButton", {
        Size = UDim2.fromOffset(66, 22), AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        BackgroundColor3 = initial_color, Text = "", AutoButtonColor = false, Parent = row,
    })
    corner(preview_btn, 4); add_stroke(preview_btn, theme.stroke)
    preview_btn.MouseButton1Click:Connect(function()
        open_color_picker(preview_btn, current_color, function(col)
            current_color = col
            preview_btn.BackgroundColor3 = col
            if on_change then on_change(col) end
        end)
    end)
    return { get = function() return current_color end, set = function(c) current_color = c; preview_btn.BackgroundColor3 = c end }
end


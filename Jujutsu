-- slider
local function mk_slider(parent, label, minv, maxv, def, step, on_change)
    local row = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, LayoutOrder = ord(), Parent = parent,
    })
    vlist(row, 4)
    local head = mk("Frame", {Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1, LayoutOrder = 1, Parent = row})
    mk("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0), BackgroundTransparency = 1, Text = label,
        Font = FMED, TextSize = 12, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = head,
    })
    local val = mk("TextLabel", {
        Size = UDim2.fromOffset(70, 14), Position = UDim2.new(1, -70, 0, 0),
        BackgroundTransparency = 1, Text = fnum(def), Font = FMED, TextSize = 12,
        TextColor3 = T.accent, TextXAlignment = Enum.TextXAlignment.Right, Parent = head,
    })
    local wrap = mk("Frame", {Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1, LayoutOrder = 2, Parent = row})
    local bar = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 0.5, -2),
        BackgroundColor3 = T.track, Parent = wrap,
    })
    rnd(bar, 2)
    local pct = math.clamp((def - minv) / (maxv - minv), 0, 1)
    local fill = mk("Frame", {Size = UDim2.new(pct, 0, 1, 0), BackgroundColor3 = T.accent, Parent = bar})
    rnd(fill, 2)
    local knob = mk("Frame", {
        Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(pct, 0, 0.5, 0), BackgroundColor3 = Color3.fromRGB(240, 240, 245), Parent = bar,
    })
    rnd(knob, 6)
    local hit = mk("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = wrap})
    local cur, dragging = def, false
    local function apply(v)
        cur = math.clamp(v, minv, maxv)
        if step then cur = math.floor(cur / step + 0.5) * step end
        cur = math.clamp(cur, minv, maxv)
        local p = (cur - minv) / (maxv - minv)
        fill.Size = UDim2.new(p, 0, 1, 0)
        knob.Position = UDim2.new(p, 0, 0.5, 0)
        val.Text = fnum(cur)
        if on_change then on_change(cur) end
    end
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            local a = (i.Position.X - wrap.AbsolutePosition.X) / math.max(wrap.AbsoluteSize.X, 1)
            apply(minv + math.clamp(a, 0, 1) * (maxv - minv))
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            local a = (i.Position.X - wrap.AbsolutePosition.X) / math.max(wrap.AbsoluteSize.X, 1)
            apply(minv + math.clamp(a, 0, 1) * (maxv - minv))
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    return api
end


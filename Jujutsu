local function make_slider(parent, label, desc, min, max, default, step, on_change)
    local row = create("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, LayoutOrder = next_order(), Parent = parent,
    })
    vlist(row, 4)
    local header = create("Frame", { Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1, LayoutOrder = 1, Parent = row })
    create("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0), BackgroundTransparency = 1, Text = label,
        Font = font_med, TextSize = 12, TextColor3 = theme.text,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = header,
    })
    local value_lbl = create("TextLabel", {
        Size = UDim2.fromOffset(70, 14), Position = UDim2.new(1, -70, 0, 0),
        BackgroundTransparency = 1, Text = fmt_num(default),
        Font = font_med, TextSize = 12, TextColor3 = theme.accent,
        TextXAlignment = Enum.TextXAlignment.Right, Parent = header,
    })
    if desc then
        create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, Text = desc,
            Font = font_ui, TextSize = 11, TextColor3 = theme.text_dim,
            TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2, Parent = row,
        })
    end
    local wrap = create("Frame", { Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1, LayoutOrder = 3, Parent = row })
    local bar = create("Frame", {
        Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 0.5, -2),
        BackgroundColor3 = theme.track_off, Parent = wrap,
    })
    corner(bar, 2)
    local pct = math.clamp((default - min) / (max - min), 0, 1)
    local fill = create("Frame", { Size = UDim2.new(pct, 0, 1, 0), BackgroundColor3 = theme.accent, Parent = bar })
    corner(fill, 2)
    local knob = create("Frame", {
        Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5,0.5),
        Position = UDim2.new(pct, 0, 0.5, 0), BackgroundColor3 = Color3.fromRGB(240,240,245), Parent = bar,
    })
    corner(knob, 6)
    local hit = create("TextButton", { Size = UDim2.fromScale(1,1), BackgroundTransparency = 1, Text = "", Parent = wrap })

    local current, dragging = default, false
    local function apply(v, silent)
        current = math.clamp(v, min, max)
        if step then current = math.floor(current / step + 0.5) * step end
        current = math.clamp(current, min, max)
        local p = (current - min) / (max - min)
        fill.Size = UDim2.new(p, 0, 1, 0)
        knob.Position = UDim2.new(p, 0, 0.5, 0)
        value_lbl.Text = fmt_num(current)
        if not silent and on_change then on_change(current) end
    end
    local function from_x(x)
        local rel = math.clamp((x - wrap.AbsolutePosition.X) / math.max(wrap.AbsoluteSize.X, 1), 0, 1)
        apply(min + rel * (max - min))
    end
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; from_x(input.Position.X) end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then from_x(input.Position.X) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    return { set = function(v,s) apply(v,s) end, get = function() return current end }
end

local function make_segmented(parent, options, default_idx, on_change)
    local row = create("Frame", {
        Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1,
        LayoutOrder = next_order(), Parent = parent,
    })
    local btns = {}
    local active = default_idx or 1
    local n = #options
    for i, opt in ipairs(options) do
        local b = create("TextButton", {
            Size = UDim2.new(1/n, -4, 1, 0),
            Position = UDim2.new((i-1)/n, 0, 0, 0),
            BackgroundColor3 = (i == active) and theme.accent or theme.panel_alt,
            Text = opt, Font = font_med, TextSize = 10,
            TextColor3 = (i == active) and Color3.fromRGB(255,255,255) or theme.text_dim,
            AutoButtonColor = false, Parent = row,
        })
        corner(b, 4); btns[i] = b
    end
    local function set(i, silent)
        active = i
        for j, b in ipairs(btns) do
            local is_a = j == i
            b.BackgroundColor3 = is_a and theme.accent or theme.panel_alt
            b.TextColor3 = is_a and Color3.fromRGB(255,255,255) or theme.text_dim
        end
        if not silent and on_change then on_change(i, options[i]) end
    end
    for i, b in ipairs(btns) do b.MouseButton1Click:Connect(function() set(i) end) end
    return { set = function(i,s) set(i,s) end, get = function() return active, options[active] end }
end


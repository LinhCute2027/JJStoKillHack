--=============================================================
-- toggle logic + keybind handler + boot
--=============================================================
local function toggle_menu()
    local show = not win.Visible
    win.Visible = show
    if not show then
        parry_window.Visible = false
    end
    update_floating_state(show)
    log(show and "menu shown" or "menu hidden")
end

close.MouseButton1Click:Connect(toggle_menu)

floating.MouseButton1Click:Connect(function()
    if fb_drag.moved then return end
    toggle_menu()
end)

UserInputService.InputBegan:Connect(function(input, processed)
    -- keybind listener — takes priority, eats the input
    if listening_for_key then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode ~= Enum.KeyCode.Escape then
                menu_keybind = input.KeyCode
                log("menu keybind -> %s", menu_keybind.Name)
            end
            listening_for_key = false
            kb_btn.Text = menu_keybind.Name
            kb_btn.TextColor3 = theme.text
        end
        return
    end

    if processed then return end
    if input.KeyCode == menu_keybind then
        toggle_menu()
    end
end)

set_page("combat_general")
update_floating_state(win.Visible)

log("loaded — %s / floating button toggles the menu", menu_keybind.Name)

local function make_check(parent, default_on, on_change)
    local on = default_on and true or false
    local box = create("TextButton", {
        Size = UDim2.fromOffset(18, 18),
        BackgroundColor3 = on and theme.accent or theme.input,
        Text = "", AutoButtonColor = false, Parent = parent,
    })
    corner(box, 4)
    local stroke = add_stroke(box, on and theme.accent or theme.stroke, 1.2)
    local tick = create("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        Text = "✓", Font = font_bold, TextSize = 12,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextTransparency = on and 0 or 1, Parent = box,
    })
    local api = { frame = box }
    function api.set(v, silent)
        on = v and true or false
        TweenService:Create(box, TweenInfo.new(0.1), { BackgroundColor3 = on and theme.accent or theme.input }):Play()
        TweenService:Create(tick, TweenInfo.new(0.1), { TextTransparency = on and 0 or 1 }):Play()
        stroke.Color = on and theme.accent or theme.stroke
        if not silent and on_change then on_change(on) end
    end
    function api.get() return on end
    box.MouseButton1Click:Connect(function() api.set(not on) end)
    return api
end


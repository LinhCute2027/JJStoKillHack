local function resolve_host()
    local ok, res = pcall(function() if type(gethui) == "function" then return gethui() end end)
    if ok and res then return res end
    return CoreGui
end
local function make_screengui(name)
    local gui = create("ScreenGui", {
        Name = name, ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 100,
    })
    if type(syn) == "table" and syn.protect_gui then pcall(syn.protect_gui, gui) end
    if type(protect_gui) == "function" then pcall(protect_gui, gui) end
    local host = resolve_host()
    local ok = pcall(function() gui.Parent = host end)
    if not ok then ok = pcall(function() gui.Parent = CoreGui end) end
    if not ok then gui.Parent = lp:WaitForChild("PlayerGui") end
    return gui
end

function nearest_player()
    local my_root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not my_root then return nil end
    local best, best_d = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if r then
                local d = (r.Position - my_root.Position).Magnitude
                if d < best_d then best, best_d = p, d end
            end
        end
    end
    return best
end


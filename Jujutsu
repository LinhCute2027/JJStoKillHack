-- macro recorder
--=============================================================
local MACRO = { recording = false, playing = false, events = {}, start_t = 0, name = "macro" }
UserInputService.InputBegan:Connect(function(input, gp)
    if not MACRO.recording or gp then return end
    table.insert(MACRO.events, { t = tick(), type = "press", it = input.UserInputType, kc = input.KeyCode })
end)
UserInputService.InputEnded:Connect(function(input, gp)
    if not MACRO.recording then return end
    table.insert(MACRO.events, { t = tick(), type = "release", it = input.UserInputType, kc = input.KeyCode })
end)
local function play_macro()
    if MACRO.playing or #MACRO.events == 0 then return end
    MACRO.playing = true
    task.spawn(function()
        local base = MACRO.events[1].t
        local t0 = tick()
        for _, ev in ipairs(MACRO.events) do
            if not MACRO.playing then break end
            local target = ev.t - base
            local elapsed = tick() - t0
            if target > elapsed then task.wait(target - elapsed) end
            if ev.type == "press" then
                if ev.it == Enum.UserInputType.MouseButton1 then JJS.mouse(1, 0.001)
                elseif ev.it == Enum.UserInputType.MouseButton2 then JJS.mouse(2, 0.001)
                elseif ev.it == Enum.UserInputType.Keyboard then JJS.key(ev.kc, 0.001) end
            end
        end
        MACRO.playing = false
    end)
end


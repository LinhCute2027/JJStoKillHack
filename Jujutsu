-- legit input layer
--=============================================================
local input_window = {}
local function rate_ok()
    local now = tick()
    for i = #input_window, 1, -1 do
        if now - input_window[i] > 1 then table.remove(input_window, i) end
    end
    if #input_window >= CFG.max_inputs_sec then return false end
    table.insert(input_window, now)
    return true
end
local function jitter() return CFG.jitter_min + math.random() * (CFG.jitter_max - CFG.jitter_min) end
local function skip()  return math.random() < CFG.skip_chance end

local function sim_mouse(btn, hold)
    local press, release
    if btn == 1 then press, release = mouse1press, mouse1release
    else press, release = mouse2press, mouse2release end
    if type(press) ~= "function" then return end
    if not rate_ok() or skip() then return end
    pcall(function()
        press()
        task.wait((hold or 0.05) + jitter() * 0.3)
        release()
    end)
end
local function sim_key(key, hold)
    if type(keypress) ~= "function" then return end
    if not rate_ok() or skip() then return end
    pcall(function()
        keypress(key)
        task.wait((hold or 0.05) + jitter() * 0.4)
        keyrelease(key)
    end)
end


local spin_t = 0

RunService.RenderStepped:Connect(function(dt)
    if not parry_window.Visible then return end
    if not preview.rig then return end

    spin_t += dt
    preview.rig:PivotTo(CFrame.new(0, 3, 0) * CFrame.Angles(0, spin_t * 0.5, 0))
    if preview.hair and preview.head then
        preview.hair.CFrame = preview.head.CFrame * CFrame.new(0, 0.58, 0)
    end

    local track = preview.track
    if track then
        local length = math.max(track.Length, 0.001)
        local pos = math.clamp(track.TimePosition, 0, length)
        time_label.Text = string.format("%.2fs / %.2fs", pos, track.Length)
        seek_fill.Size = UDim2.new(pos / length, 0, 1, 0)
    else
        time_label.Text = "0.00s / 0.00s"
        seek_fill.Size = UDim2.new(0, 0, 1, 0)
    end
end)


local _lighting_orig = nil
local function apply_fullbright(on)
    if on and not _lighting_orig then
        _lighting_orig = {
            Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
            Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime,
            FogEnd = Lighting.FogEnd, ExposureCompensation = Lighting.ExposureCompensation,
        }
        Lighting.Ambient = Color3.fromRGB(200,200,200)
        Lighting.OutdoorAmbient = Color3.fromRGB(200,200,200)
        Lighting.Brightness = 2
        Lighting.ClockTime = 12
        Lighting.FogEnd = 100000
        Lighting.ExposureCompensation = 0.3
    elseif not on and _lighting_orig then
        for k, v in pairs(_lighting_orig) do pcall(function() Lighting[k] = v end) end
        _lighting_orig = nil
    end
end

local _fps_orig = nil
local function apply_fps_boost(on)
    if on and not _fps_orig then
        _fps_orig = { GlobalShadows = Lighting.GlobalShadows, QualityLevel = Lighting.QualityLevel }
        Lighting.GlobalShadows = false
        pcall(function() Lighting.QualityLevel = Enum.QualityLevel.Level01 end)
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("Decal") or d:IsA("Texture") then
                pcall(function() d.Transparency = 1 end)
            elseif d:IsA("BasePart") and d.Material ~= Enum.Material.SmoothPlastic then
                pcall(function() d.Material = Enum.Material.SmoothPlastic end)
            end
        end
    elseif not on and _fps_orig then
        pcall(function() Lighting.GlobalShadows = _fps_orig.GlobalShadows end)
        pcall(function() Lighting.QualityLevel = _fps_orig.QualityLevel end)
        _fps_orig = nil
    end
end


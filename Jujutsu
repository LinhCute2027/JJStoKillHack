--=============================================================
-- legit input layer
--=============================================================
local input_window = {}
local function rate_ok()
    if not JJS.F.rate_limit then return true end
    local now = tick()
    for i = #input_window, 1, -1 do
        if now - input_window[i] > 1 then table.remove(input_window, i) end
    end
    if #input_window >= JJS.CFG.max_inputs_sec then return false end
    table.insert(input_window, now)
    return true
end
local function jitter()
    if not JJS.F.input_jitter then return 0 end
    return JJS.CFG.jitter_min + math.random() * (JJS.CFG.jitter_max - JJS.CFG.jitter_min)
end
local function skip_rng()
    if not JJS.F.random_skip then return false end
    return math.random() < JJS.CFG.skip_chance
end
local function focus_ok()
    if not JJS.CFG.disable_on_unfocus then return true end
    return UserInputService.WindowFocused
end

function JJS.mouse(btn, hold)
    if not rate_ok() or skip_rng() or not focus_ok() then return end
    hold = hold or 0.05
    local button = (btn == 1) and 0 or 1   -- VIM: 0 left, 1 right
    local ok = _vim_mouse(button, true, hold)
    if not ok then
        if btn == 1 and type(mouse1press) == "function" then
            pcall(function() mouse1press(); task.wait(hold); mouse1release() end)
        elseif btn == 2 and type(mouse2press) == "function" then

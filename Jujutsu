-- ESP
local highlights = {}
local function apply_esp(char)
    if not char or highlights[char] then return end
    local hl = Instance.new("Highlight")
    hl.Name = "jjs_esp"
    hl.FillColor = CFG.esp_color
    hl.FillTransparency = 0.6
    hl.OutlineColor = Color3.fromRGB(255,255,255)
    hl.OutlineTransparency = 0.2
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = char
    highlights[char] = hl
end
local function clear_esp()
    for c, hl in pairs(highlights) do
        if hl and hl.Parent then hl:Destroy() end
    end
    highlights = {}
end
task.spawn(function()
    while true do
        task.wait(0.3)
        if FEAT.esp then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= lp and p.Character then
                    local h = p.Character:FindFirstChildOfClass("Humanoid")
                    if h and h.Health > 0 then
                        local my = my_root()
                        local er = p.Character:FindFirstChild("HumanoidRootPart")
                        if my and er and dist(my.Position, er.Position) <= CFG.esp_max_dist then
                            apply_esp(p.Character)
                        end
                    end
                end
            end
        elseif next(highlights) then
            clear_esp()
        end
    end
end)


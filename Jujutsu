_G.__jjs_reg = _G.__jjs_reg or {}

local function is_benign(name)
    if not name or name == "" then return true end
    local n = name:lower()
    for _, h in ipairs({"idle", "walk", "run", "jump", "fall", "climb", "swim", "emote", "dance", "toolnone", "sit", "stand", "equip", "spawn"}) do
        if n:find(h, 1, true) then return true end
    end
    return false
end

local function do_parry(enemy, is_m1)
    if not F.auto_parry then return end
    if enemy and F.aim_check and not aiming_at(enemy) then return end
    if math.random() > CFG.parry_success then return end
    local rng = is_m1 and CFG.parry_range_m1 or CFG.parry_range_skill
    if enemy then
        local my = my_root(); local er = root_of(enemy)
        if my and er and dist(my.Position, er.Position) > rng then return end
    end
    if F.face_target and enemy then face(enemy, CFG.pre_face_delay) end
    task.spawn(function()
        task.wait(CFG.parry_delay + CFG.parry_extra_delay + jit())
        press_m2(CFG.parry_hold + CFG.parry_extra_hold)
        if CFG.parry_hold_after > 0 then task.wait(CFG.parry_hold_after) end
    end)
end

local anim_hooked = {}
local function hook_anim(enemy, animator)
    if anim_hooked[animator] then return end
    anim_hooked[animator] = true
    animator.AnimationPlayed:Connect(function(track)
        local ok, anim = pcall(function() return track.Animation end)
        if not ok or not anim then return end
        local id = tostring(anim.AnimationId or "")
        local digits = id:match("(%d+)")
        if not digits then return end
        local name = anim.Name or ""
        local reg = _G.__jjs_reg[digits]
        if not reg then reg = {count = 0, name = name}; _G.__jjs_reg[digits] = reg end
        reg.count = reg.count + 1
        if name ~= "" then reg.name = name end
        if F.anim_logger then
            print(string.format("[jjs-learn] %s | %s | id=%s", enemy.Name, name ~= "" and name or "?", digits))
        end
        if not is_benign(name) then do_parry(enemy, false) end
    end)
end


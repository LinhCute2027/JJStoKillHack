end

function JJS.key(keycode, hold)
    if not rate_ok() or skip_rng() or not focus_ok() then return end
    hold = hold or 0.05
    local ok = _vim_key(keycode, true, hold)
    if not ok and type(keypress) == "function" then
        pcall(function() keypress(keycode); task.wait(hold); keyrelease(keycode) end)
    end
end


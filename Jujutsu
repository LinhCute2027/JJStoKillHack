--=============================================================
-- drag engine
--=============================================================
local drag    = { active = false, frame = nil, start = nil, origin = nil }
local fb_drag = { active = false, moved = false, btn = nil, start = nil, origin = nil }
UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
    if drag.active and drag.frame then
        local d = input.Position - drag.start
        drag.frame.Position = UDim2.new(drag.origin.X.Scale, drag.origin.X.Offset + d.X, drag.origin.Y.Scale, drag.origin.Y.Offset + d.Y)
    end
    if fb_drag.active and fb_drag.btn then
        local d = input.Position - fb_drag.start
        if d.Magnitude > 3 then fb_drag.moved = true end
        fb_drag.btn.Position = UDim2.new(fb_drag.origin.X.Scale, fb_drag.origin.X.Offset + d.X, fb_drag.origin.Y.Scale, fb_drag.origin.Y.Offset + d.Y)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        drag.active = false; drag.frame = nil
        fb_drag.active = false; fb_drag.btn = nil
    end
end)
local function make_draggable(frame, handle)
    handle = handle or frame
    handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        drag.active = true; drag.frame = frame; drag.start = input.Position; drag.origin = frame.Position
    end)
end


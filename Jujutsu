function preview_animation(id)
    if not preview.animator then return end
    local digits = tostring(id):match("%d+")
    if not digits then return end
    preview.last_id = digits

    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. digits
    local ok, track = pcall(function()
        return preview.animator:LoadAnimation(anim)
    end)
    if not ok or not track then
        log("couldn't load animation %s", digits)
        return
    end

    local old = preview.track
    if old then pcall(function() old:Stop() end) end

    track.Priority = Enum.AnimationPriority.Action
    track.Looped = true
    track:Play()
    track:AdjustSpeed(preview.speed)
    preview.track = track
end

local function speed_text(x)
    if x == 0.25 then return "0.25x" end
    if x == 0.5 then return "0.5x" end
    return "1.0x"
end

function set_speed(x)
    preview.speed = x
    if speed_label then speed_label.Text = "Speed: " .. speed_text(x) end
    if preview.track then preview.track:AdjustSpeed(x) end
end

function replay_preview()
    if preview.last_id then preview_animation(preview.last_id) end
end


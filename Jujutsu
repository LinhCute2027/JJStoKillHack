-- color picker popup (HSV)
local function open_color_picker(anchor, initial_color, on_change)
    if _G.__jjs_color_popup and _G.__jjs_color_popup.Parent then _G.__jjs_color_popup:Destroy() end
    local h0, s0, v0 = rgb_to_hsv(initial_color.R * 255, initial_color.G * 255, initial_color.B * 255)
    local h, s, v = h0, s0, v0

    local popup = create("Frame", {
        Size = UDim2.fromOffset(240, 224),
        BackgroundColor3 = theme.panel,
        ZIndex = 60, Parent = gui,
    })
    _G.__jjs_color_popup = popup
    corner(popup, 6); add_stroke(popup, theme.stroke)

    local abs_pos = anchor.AbsolutePosition
    popup.Position = UDim2.fromOffset(abs_pos.X - 200, abs_pos.Y + anchor.AbsoluteSize.Y + 6)

    local sv = create("Frame", {
        Size = UDim2.fromOffset(216, 140),
        Position = UDim2.fromOffset(12, 12),
        BackgroundColor3 = Color3.fromRGB(255, 0, 0), Parent = popup,
    })
    corner(sv, 4)
    local hue_base = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 0, 0), Parent = sv })
    corner(hue_base, 4)
    create("UIGradient", {
        Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255,255,255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255,0,0)) }),
        Parent = hue_base,
    })
    local dark_over = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(0,0,0), Parent = sv })
    corner(dark_over, 4)
    create("UIGradient", {
        Rotation = 90,
        Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }),
        Parent = dark_over,
    })
    local sv_hit = create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = sv })
    local cursor = create("Frame", {
        Size = UDim2.fromOffset(10, 10), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(s, 0, 1 - v, 0), BackgroundTransparency = 1, ZIndex = 2, Parent = sv,
    })
    corner(cursor, 5); add_stroke(cursor, Color3.fromRGB(255,255,255), 2)

    local hue_bar = create("Frame", { Size = UDim2.fromOffset(216, 14), Position = UDim2.fromOffset(12, 162), Parent = popup })
    corner(hue_bar, 4)
    create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.000, Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255, 255, 0)),
            ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
            ColorSequenceKeypoint.new(0.500, Color3.fromRGB(0, 255, 255)),
            ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0, 0, 255)),
            ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
            ColorSequenceKeypoint.new(1.000, Color3.fromRGB(255, 0, 0)),
        }),
        Parent = hue_bar,
    })
    local hue_hit = create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = hue_bar })
    local hue_cursor = create("Frame", {
        Size = UDim2.fromOffset(4, 18), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(h / 360, 0, 0.5, 0),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255), Parent = hue_bar,
    })
    corner(hue_cursor, 2); add_stroke(hue_cursor, theme.bg, 1)

    local hex_box = create("TextBox", {
        Size = UDim2.fromOffset(216, 24), Position = UDim2.fromOffset(12, 186),
        BackgroundColor3 = theme.input, Text = rgb_to_hex(initial_color.R*255, initial_color.G*255, initial_color.B*255),
        Font = font_mono, TextSize = 11, TextColor3 = theme.text,
        TextXAlignment = Enum.TextXAlignment.Center,
        ClearTextOnFocus = false, Parent = popup,
    })
    corner(hex_box, 4); add_stroke(hex_box, theme.stroke)

    local function apply(apply_callback)
        local r, g, b = hsv_to_rgb(h, s, v)
        hue_base.BackgroundColor3 = Color3.fromRGB(hsv_to_rgb(h, 1, 1))
        cursor.Position = UDim2.new(s, 0, 1 - v, 0)
        hue_cursor.Position = UDim2.new(h / 360, 0, 0.5, 0)
        hex_box.Text = rgb_to_hex(r, g, b)
        if apply_callback and on_change then on_change(Color3.fromRGB(r, g, b)) end
    end
    apply(false)

    local sv_drag, hue_drag = false, false
    local function sv_from_xy(x, y)
        s = math.clamp((x - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
        v = 1 - math.clamp((y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
        apply(true)
    end
    local function hue_from_x(x)
        h = math.clamp((x - hue_bar.AbsolutePosition.X) / hue_bar.AbsoluteSize.X, 0, 1) * 360
        apply(true)
    end
    sv_hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then sv_drag = true; sv_from_xy(input.Position.X, input.Position.Y) end
    end)
    hue_hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then hue_drag = true; hue_from_x(input.Position.X) end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        if sv_drag then sv_from_xy(input.Position.X, input.Position.Y) end
        if hue_drag then hue_from_x(input.Position.X) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then sv_drag = false; hue_drag = false end
    end)
    hex_box.FocusLost:Connect(function()
        local r, g, b = hex_to_rgb(hex_box.Text)
        h, s, v = rgb_to_hsv(r, g, b)
        apply(true)
    end)

    -- click outside to close
    task.spawn(function()
        local started = tick()
        while popup.Parent and tick() - started > 0.2 do
            if UserInputService:GetFocusedTextBox() == nil then break end
            task.wait(0.1)
        end
        while popup.Parent do
            local mouse = UserInputService:GetMouseLocation()
            local pp = popup.AbsolutePosition; local ps = popup.AbsoluteSize
            if not (mouse.X >= pp.X and mouse.X <= pp.X + ps.X and mouse.Y >= pp.Y and mouse.Y <= pp.Y + ps.Y) then
                if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                    task.wait(0.05)
                    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                        popup:Destroy(); return
                    end
                end
            end
            task.wait(0.05)
        end
    end)
end


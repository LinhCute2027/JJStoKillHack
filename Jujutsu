-- ========== INPUT ==========
local input_buf = {}
local function rate_ok()
    if not F.rate_limit then return true end
    local now = tick()
    for i = #input_buf, 1, -1 do
        if now - input_buf[i] > 1 then table.remove(input_buf, i) end
    end
    if #input_buf >= CFG.max_inputs then return false end
    table.insert(input_buf, now)
    return true
end
local function jit()
    if not F.jitter_on then return 0 end
    return CFG.jitter_min + math.random() * (CFG.jitter_max - CFG.jitter_min)
end
local function skipit()
    if not F.skip_on then return false end
    return math.random() < CFG.skip_p
end
local function focused()
    if not F.disable_unfocused then return true end
    local ok, val = pcall(function() return UIS.WindowFocused end)
    if not ok then return true end
    return val
end

local function vim_mouse(btn, hold)
    if not VIM then return false end
    local m = UIS:GetMouseLocation()
    local ok = pcall(function()
        VIM:SendMouseButtonEvent(m.X, m.Y, btn, true, game, btn + 1)
        task.wait(hold)
        VIM:SendMouseButtonEvent(m.X, m.Y, btn, false, game, btn + 1)
    end)
    return ok
end
local function vim_key(kc, hold)
    if not VIM then return false end
    local ok = pcall(function()
        VIM:SendKeyEvent(true, kc, false, game)
        task.wait(hold)
        VIM:SendKeyEvent(false, kc, false, game)
    end)
    if ok then return true end
    ok = pcall(function()
        VIM:SendKeyEvent(true, kc, false)
        task.wait(hold)
        VIM:SendKeyEvent(false, kc, false)
    end)
    return ok
end


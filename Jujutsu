local function mk(class, props)
    local inst = Instance.new(class)
    local par
    for k, v in pairs(props or {}) do
        if k == "Parent" then par = v else inst[k] = v end
    end
    if par then inst.Parent = par end
    return inst
end
local function rnd(parent, r)
    mk("UICorner", {CornerRadius = UDim.new(0, r or 6), Parent = parent})
end
local function str(parent, c, t, tr)
    mk("UIStroke", {Color = c or T.stroke, Thickness = t or 1, Transparency = tr or 0, Parent = parent})
end
local function pad(parent, t, r, b, l)
    mk("UIPadding", {
        PaddingTop = UDim.new(0, t or 0),
        PaddingRight = UDim.new(0, r or t or 0),
        PaddingBottom = UDim.new(0, b or t or 0),
        PaddingLeft = UDim.new(0, l or r or t or 0),
        Parent = parent,
    })
end
local function vlist(parent, gap)
    mk("UIListLayout", {Padding = UDim.new(0, gap or 0), SortOrder = Enum.SortOrder.LayoutOrder, Parent = parent})
end
local ORD = 0
local function ord() ORD = ORD + 1 return ORD end
local function fnum(v)
    v = tonumber(v) or 0
    if v == math.floor(v) then return tostring(math.floor(v)) end
    return (string.format("%.3f", v):gsub("0+$", ""):gsub("%.$", ""))
end
local function dist(a, b) if not a or not b then return math.huge end return (a - b).Magnitude end
local function root_of(p)
    if not p or not p.Character then return nil end
    return p.Character:FindFirstChild("HumanoidRootPart")
end
local function my_root()
    if not lp.Character then return nil end
    return lp.Character:FindFirstChild("HumanoidRootPart")
end
local function my_hum()
    if not lp.Character then return nil end
    return lp.Character:FindFirstChildOfClass("Humanoid")
end
local function nearest(maxd, alive)
    local my = my_root(); if not my then return nil, math.huge end
    local best, bd = nil, maxd or math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp then
            local r = root_of(p)
            local h = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            if r and (not alive or (h and h.Health > 0)) then
                local d = dist(my.Position, r.Position)
                if d < bd then best, bd = p, d end
            end
        end
    end
    return best, bd
end
local function face(enemy, delay)
    task.spawn(function()
        if delay and delay > 0 then task.wait(delay) end
        local my = my_root(); local er = root_of(enemy)
        if not my or not er then return end
        local dir = er.Position - my.Position
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude < 0.01 then return end
        pcall(function() my.CFrame = CFrame.lookAt(my.Position, my.Position + dir) end)
    end)
end
local function aiming_at(enemy)
    local er = root_of(enemy); local my = my_root()
    if not er or not my then return true end
    local to_me = my.Position - er.Position
    to_me = Vector3.new(to_me.X, 0, to_me.Z)
    if to_me.Magnitude < 0.01 then return true end
    local look = er.CFrame.LookVector
    look = Vector3.new(look.X, 0, look.Z)
    return look:Dot(to_me.Unit) > 0.3
end


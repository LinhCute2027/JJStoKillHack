local function make_switch(parent, default_on, on_change)
    local on = default_on and true or false
    local track = create("Frame", {
        Size = UDim2.fromOffset(32, 16),
        BackgroundColor3 = on and theme.accent or theme.track_off,
        Parent = parent,
    })
    corner(track, 8)
    local knob = create("Frame", {
        Size = UDim2.fromOffset(10, 10),
        AnchorPoint = Vector2.new(0, 0.5),
        Position = on and UDim2.new(1, -12, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
        BackgroundColor3 = Color3.fromRGB(240, 240, 245),
        Parent = track,
    })
    corner(knob, 5)
    local hit = create("TextButton", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = track,
    })

    local api = { frame = track }
    function api.set(value, silent)
        on = value and true or false
        TweenService:Create(track, TweenInfo.new(0.14), {
            BackgroundColor3 = on and theme.accent or theme.track_off,
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.14), {
            Position = on and UDim2.new(1, -12, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
        }):Play()
        if not silent and on_change then on_change(on) end
    end
    function api.get() return on end
    hit.MouseButton1Click:Connect(function() api.set(not on) end)
    return api
end

local function make_button(parent, text, width, height, on_click, opts)
    opts = opts or {}
    local bg = opts.bg or theme.panel_alt
    local b = create("TextButton", {
        Size = UDim2.fromOffset(width, height or 22),
        BackgroundColor3 = bg,
        Text = text,
        Font = font_med,
        TextSize = opts.textsize or 10,
        TextColor3 = opts.color or theme.text_dim,
        AutoButtonColor = false,
        TextTruncate = Enum.TextTruncate.AtEnd,
        LayoutOrder = opts.layout_order or 0,
        Parent = parent,
    })
    corner(b, 4)
    add_stroke(b, opts.stroke or theme.stroke)
    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.1), { BackgroundColor3 = opts.hover or theme.hover }):Play()
    end)
    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.1), { BackgroundColor3 = bg }):Play()
    end)
    if on_click then b.MouseButton1Click:Connect(on_click) end
    return b
end

local function make_input(parent, placeholder, default)
    local box = create("TextBox", {
        Size = UDim2.new(1, 0, 0, 24),
        BackgroundColor3 = theme.input,
        Text = default or "",
        PlaceholderText = placeholder or "",
        PlaceholderColor3 = theme.text_faint,
        Font = font_ui,
        TextSize = 11,
        TextColor3 = theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        Parent = parent,
    })
    corner(box, 4)
    add_stroke(box, theme.stroke)
    pad(box, 0, 8, 0, 8)
    return box
end


--=============================================================
-- engine — spatial + anim watcher
--=============================================================
local function dist(a, b) if not a or not b then return math.huge end return (a - b).Magnitude end
local function my_root()
    local c = lp.Character; if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart")
end
local function get_root(p)
    if not p or not p.Character then return nil end
    return p.Character:FindFirstChild("HumanoidRootPart")
end
local function nearest_enemy(max_d)
    local my = my_root(); if not my then return nil, math.huge end
    local best, bd = nil, max_d or math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp then
            local r = get_root(p)
            local h = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = dist(my.Position, r.Position)
                if d < bd then best, bd = p, d end
            end
        end
    end
    return best, bd
end

local function register_anim(digits, name)
    local e = REGISTRY[digits]
    if not e then
        e = { count = 0, first_t = tick(), last_t = 0, name = name or "" }
        REGISTRY[digits] = e
    end
    e.count = e.count + 1
    e.last_t = tick()
    if name and name ~= "" then e.name = name end
end

local function is_attack_anim(name)
    if not name then return false end
    local n = name:lower()
    local hints = { "attack", "punch", "m1", "m2", "slash", "cleave", "dismantle",
        "kick", "rush", "slam", "beam", "burst", "skill", "special", "combat",
        "swing", "sword", "cast", "hit" }
    for _, h in ipairs(hints) do if n:find(h, 1, true) then return true end end
    local benign_hints = { "idle", "walk", "run", "jump", "fall", "climb",
        "swim", "emote", "dance", "toolnone", "sit" }
    for _, h in ipairs(benign_hints) do if n:find(h, 1, true) then return false end end
    return true
end

local function on_enemy_attack(enemy)
    if not FEAT.auto_parry then return end
    local my = my_root(); if not my then return end
    local er = get_root(enemy); if not er then return end
    if dist(my.Position, er.Position) > CFG.parry_range then return end
    task.spawn(function()
        task.wait(CFG.parry_delay + jitter())
        sim_mouse(2, CFG.parry_hold)
    end)
end

local core_animators = {}
local function hook_core_animator(enemy, animator)
    if core_animators[animator] then return end
    core_animators[animator] = true
    animator.AnimationPlayed:Connect(function(track)
        local ok, anim = pcall(function() return track.Animation end)
        if not ok or not anim then return end
        local id = tostring(anim.AnimationId or "")
        local digits = id:match("(%d+)")
        if not digits then return end
        local name = anim.Name or ""
        register_anim(digits, name)
        if FEAT.learn then
            local _p = _G.__jjs_orig_print or print
            _p(string.format("[jjs-learn] %s | anim=%s | id=%s",
                enemy.Name, name ~= "" and name or "?", digits))
        end
        if is_attack_anim(name) then on_enemy_attack(enemy) end
    end)
end

local core_watched = {}
local function watch_core_enemy(p)
    if p == lp or core_watched[p] then return end
    core_watched[p] = true
    local function hook_char(char)
        local hum = char:WaitForChild("Humanoid", 5); if not hum then return end
        local animator = hum:WaitForChild("Animator", 5); if not animator then return end
        hook_core_animator(p, animator)
    end
    if p.Character then task.spawn(hook_char, p.Character) end
    p.CharacterAdded:Connect(hook_char)
end
for _, p in ipairs(Players:GetPlayers()) do watch_core_enemy(p) end
Players.PlayerAdded:Connect(watch_core_enemy)

-- self animator for black flash
local self_animator
local function hook_self_animator()
    local char = lp.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator"); if not animator then return end
    if self_animator == animator then return end
    self_animator = animator
    animator.AnimationPlayed:Connect(function(track)
        if not FEAT.black_flash then return end
        local ok, anim = pcall(function() return track.Animation end)
        if not ok or not anim then return end
        local n = (anim.Name or ""):lower()
        if n:find("m1") or n:find("punch") or n:find("combo") or n:find("attack") then
            task.spawn(function()
                task.wait(CFG.bf_delay + jitter())
                sim_mouse(1, 0.05)
            end)
        end
    end)
end
lp.CharacterAdded:Connect(function() task.wait(1.5); task.spawn(hook_self_animator) end)
if lp.Character then task.wait(0.6); task.spawn(hook_self_animator) end


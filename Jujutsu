-- helpers
local function dist(a, b) if not a or not b then return math.huge end return (a - b).Magnitude end
local function my_root()
    local c = lp.Character; if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart")
end
local function my_hum()
    local c = lp.Character; if not c then return nil end
    return c:FindFirstChildOfClass("Humanoid")
end
local function get_root(p)
    if not p or not p.Character then return nil end
    return p.Character:FindFirstChild("HumanoidRootPart")
end
local function nearest_enemy(max_d, alive_only)
    local my = my_root(); if not my then return nil, math.huge end
    local best, bd = nil, max_d or math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp then
            local r = get_root(p)
            local h = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            if r and (not alive_only or (h and h.Health > 0)) then
                local d = dist(my.Position, r.Position)
                if d < bd then best, bd = p, d end
            end
        end
    end
    return best, bd
end

local function face_enemy(enemy, delay, duration)
    task.spawn(function()
        if delay > 0 then task.wait(delay) end
        local my = my_root(); local er = get_root(enemy)
        if not my or not er then return end
        local dir = er.Position - my.Position
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude < 0.01 then return end
        my.CFrame = CFrame.lookAt(my.Position, my.Position + dir)
    end)
end

local function enemy_aiming_at_me(enemy)
    local er = get_root(enemy); local my = my_root()
    if not er or not my then return true end
    local to_me = my.Position - er.Position
    to_me = Vector3.new(to_me.X, 0, to_me.Z)
    if to_me.Magnitude < 0.01 then return true end
    local look = er.CFrame.LookVector
    look = Vector3.new(look.X, 0, look.Z)
    return look:Dot(to_me.Unit) > 0.3
end

local function get_enemy_velocity(enemy)
    local er = get_root(enemy)
    if not er then return Vector3.zero end
    return er.AssemblyLinearVelocity or Vector3.zero
end

-- anim registry
local REGISTRY = {}
local CORE_ANIMATORS = {}
local function register_anim(digits, name)
    local e = REGISTRY[digits]
    if not e then e = { count = 0, first_t = tick(), last_t = 0, name = name or "" }; REGISTRY[digits] = e end
    e.count = e.count + 1; e.last_t = tick()
    if name and name ~= "" then e.name = name end
end
JJS.registry = REGISTRY
function JJS.dump_registry()
    local list = {}
    for id, e in pairs(REGISTRY) do table.insert(list, { id = id, name = e.name, count = e.count }) end
    table.sort(list, function(a,b) return a.count > b.count end)
    print("[jjs-core] === anim registry dump ===")
    for _, r in ipairs(list) do print(string.format("  id=%s | name=%s | hits=%d", r.id, r.name ~= "" and r.name or "?", r.count)) end
end

local function is_m1_anim(name)
    if not name then return false end
    local n = name:lower()
    return n:find("m1") or n:find("punch") or n:find("combo") or n:find("melee") or n:find("m2") and true or false
end
local function is_benign_anim(name)
    if not name then return true end
    local n = name:lower()
    for _, h in ipairs({"idle","walk","run","jump","fall","climb","swim","emote","dance","toolnone","sit","stand","equip","unequip","spawn"}) do
        if n:find(h, 1, true) then return true end
    end
    return false
end

--=============================================================
-- parry execution
--=============================================================
local function execute_parry(enemy, is_m1)
    if not JJS.F.auto_parry then return end
    if enemy and JJS.F.aim_check and not enemy_aiming_at_me(enemy) then return end
    if math.random() > JJS.CFG.parry_success then return end

    local range = is_m1 and JJS.CFG.parry_range_m1 or JJS.CFG.parry_range_skill
    if enemy then
        local my = my_root(); local er = get_root(enemy)
        if my and er and dist(my.Position, er.Position) > range then return end
    end

    -- dự đoán vị trí (không đổi timing nhưng ảnh hưởng tới aim check nếu có)
    if enemy and JJS.CFG.parry_motion_pred > 0 then
        local er = get_root(enemy)
        local vel = er and er.AssemblyLinearVelocity or Vector3.zero
        -- cập nhật aim check với vị trí dự đoán
        face_enemy(enemy, 0, 0)
    end

    if JJS.F.face_target or JJS.CFG.face_target then
        face_enemy(enemy, JJS.CFG.pre_face_delay, JJS.CFG.face_duration)
    end

    task.spawn(function()
        task.wait(JJS.CFG.parry_delay + JJS.CFG.parry_extra_delay + jitter())
        JJS.F.parry_active = true
        JJS.mouse(2, JJS.CFG.parry_hold + JJS.CFG.parry_extra_hold)
        task.wait(JJS.CFG.parry_hold_after)
        JJS.F.parry_active = false
    end)
end

--=============================================================
-- anim hook — enemy
--=============================================================
local function hook_enemy_animator(enemy, animator)
    if CORE_ANIMATORS[animator] then return end
    CORE_ANIMATORS[animator] = true
    animator.AnimationPlayed:Connect(function(track)
        local ok, anim = pcall(function() return track.Animation end)
        if not ok or not anim then return end
        local id = tostring(anim.AnimationId or "")
        local digits = id:match("(%d+)")
        if not digits then return end
        local name = anim.Name or ""
        register_anim(digits, name)
        if JJS.F.anim_logger then
            print(string.format("[jjs-learn] %s | %s | id=%s", enemy.Name, name ~= "" and name or "?", digits))
        end
        if is_benign_anim(name) then return end
        execute_parry(enemy, is_m1_anim(name))
    end)
end
local ENEMY_WATCHED = {}
local function watch_enemy(p)
    if p == lp or ENEMY_WATCHED[p] then return end
    ENEMY_WATCHED[p] = true
    local function hook_char(char)
        local hum = char:WaitForChild("Humanoid", 5); if not hum then return end
        local animator = hum:WaitForChild("Animator", 5); if not animator then return end
        hook_enemy_animator(p, animator)
    end
    if p.Character then task.spawn(hook_char, p.Character) end
    p.CharacterAdded:Connect(hook_char)
end
for _, p in ipairs(Players:GetPlayers()) do watch_enemy(p) end
Players.PlayerAdded:Connect(watch_enemy)

--=============================================================
-- self animator (cho black flash, dodge)
--=============================================================
local SELF_ANIM = nil
local function hook_self_animator()
    local char = lp.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator"); if not animator then return end
    if SELF_ANIM == animator then return end
